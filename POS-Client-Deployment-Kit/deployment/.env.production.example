# Copy this file to the repository root as .env and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
PUBLIC_BIND_IP=0.0.0.0
PUBLIC_HTTP_PORT=8080
CLIENT_ORIGIN=http://YOUR_SERVER_IP:8080

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
DEFAULT_BRANCH_NAME=Main Branch

MONGO_ROOT_USERNAME=posroot
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

# Notifications remain disabled until you deliberately configure and test them.
NOTIFICATIONS_WORKER_ENABLED=false
NOTIFICATION_MIN_DELAY_MS=6000
NOTIFICATION_MAX_DELAY_MS=12000
NOTIFICATION_MAX_ATTEMPTS=5
WAHA_URL=http://waha:3000
WAHA_API_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
WAHA_SESSION=default
WAHA_TIMEOUT_MS=12000
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
