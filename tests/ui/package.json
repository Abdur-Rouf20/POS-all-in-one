{
  "name": "pos-ui-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright UI regression tests for POS-all-in-one",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/health.spec.js tests/auth.spec.js",
    "report": "playwright show-report ./playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=20"
  }
}
