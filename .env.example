# Copy to .env and replace every placeholder before starting Docker.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeThisPassword123!
DEFAULT_BRANCH_NAME=Main Branch
GRAFANA_ADMIN_PASSWORD=YourStrongUniquePasswordHere

# Customer notifications (Phase A-C)
NOTIFICATIONS_WORKER_ENABLED=false
NOTIFICATION_MIN_DELAY_MS=6000
NOTIFICATION_MAX_DELAY_MS=12000
NOTIFICATION_MAX_ATTEMPTS=5
WAHA_URL=http://waha:3000
WAHA_API_KEY=replace-with-a-long-random-secret
WAHA_SESSION=default
WAHA_TIMEOUT_MS=12000
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-strong-password
